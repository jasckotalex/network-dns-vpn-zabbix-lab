options {
        directory "/var/cache/bind";

        recursion yes;

        allow-query {
                localhost;
                10.10.10.0/24;
                10.10.20.0/24;
                10.20.10.0/24;
        };

        allow-recursion {
                localhost;
                10.10.10.0/24;
                10.10.20.0/24;
                10.20.10.0/24;
        };

        allow-query-cache {
                localhost;
                10.10.10.0/24;
                10.10.20.0/24;
                10.20.10.0/24;
        };

        forwarders {
                8.8.8.8;
                1.1.1.1;
        };

        forward only;

        dnssec-validation auto;

        listen-on {
                127.0.0.1;
                10.10.20.10;
        };

        listen-on-v6 {
                none;
        };
};
